# --- Image versions (pinned, no `latest`) ---
POSTGRES_VERSION=18.6
KAFKA_VERSION=4.3.1
DEBEZIUM_VERSION=3.7.0.Final
SCHEMA_REGISTRY_VERSION=8.3.2
AKHQ_VERSION=0.28.0
PGADMIN_VERSION=9.18
PROMETHEUS_VERSION=v3.15.0
GRAFANA_VERSION=12.4.1
OTEL_COLLECTOR_VERSION=0.149.0
POSTGRES_EXPORTER_VERSION=v0.20.1
# JMX exporter javaagent on the Connect JVM (from Maven Central)
JMX_EXPORTER_VERSION=1.0.1
# Confluent Avro converter plugin version (must track SCHEMA_REGISTRY_VERSION line)
AVRO_CONVERTER_VERSION=8.3.2

# --- Tenancy ---
TARGET_TENANT=tenant_a
GEN_TENANTS=tenant_a,tenant_b,tenant_c

# --- Generator settings ---
GEN_CREATE_INTERVAL=500ms
GEN_MAX_INFLIGHT=100
GEN_SEED=42

# --- Test-only credentials (POC, never reuse) ---
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=postgres
SOURCE_DB_NAME=payments
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=debezium
SINK_DB_USER=postgres
SINK_DB_PASSWORD=postgres
SINK_DB_NAME=sink
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin
